{% extends 'partials/base.html.twig' %}

{% set route = admin.route|trim('/') %}
{% set parts = route ? route|split('/') : [] %}
{% set mode = parts[0]|default('') %}
{% set edit_name = mode == 'edit' ? parts[1]|default('') : '' %}
{% set is_editor = mode in ['add', 'edit'] %}
{% set is_submissions = mode == 'submissions' %}
{% set submissions_form = is_submissions ? parts[1]|default('') : '' %}
{% set submission_id = is_submissions ? parts[2]|default('') : '' %}
{% set is_submission_detail = is_submissions and submission_id != '' %}

{% if is_editor %}
    {% set data = admin.data('easyform/' ~ edit_name) %}
{% endif %}

{% block titlebar %}
    <div class="button-bar">
        {% if is_editor %}
            <a class="button" href="{{ admin_route('/easyform') }}"><i class="fa fa-reply"></i> {{ "PLUGIN_EASYFORMS.BACK_TO_LIST"|t }}</a>
            <button class="button" type="submit" name="task" value="easyformSave" form="easyform-editor"><i class="fa fa-check"></i> {{ "PLUGIN_EASYFORMS.SAVE"|t }}</button>
        {% elseif is_submission_detail %}
            <a class="button" href="{{ admin_route('/easyform/submissions/' ~ submissions_form) }}"><i class="fa fa-reply"></i> {{ "PLUGIN_EASYFORMS.BACK_TO_SUBMISSIONS"|t }}</a>
        {% elseif is_submissions %}
            <a class="button" href="{{ admin_route('/easyform') }}"><i class="fa fa-reply"></i> {{ "PLUGIN_EASYFORMS.BACK_TO_LIST"|t }}</a>
            <a class="button" href="{{ uri.addNonce(admin_route('/easyform/export/' ~ submissions_form) ~ '/task' ~ config.system.param_sep ~ 'easyformExport', 'admin-form', 'admin-nonce') }}"><i class="fa fa-download"></i> {{ "PLUGIN_EASYFORMS.EXPORT_CSV"|t }}</a>
        {% else %}
            <a class="button" href="{{ admin_route('/easyform/add') }}"><i class="fa fa-plus"></i> {{ "PLUGIN_EASYFORMS.ADD"|t }}</a>
        {% endif %}
    </div>
    <h1><i class="fa fa-fw fa-wpforms"></i> {{ "PLUGIN_EASYFORMS.MENU"|t }}{% if mode == 'edit' %}: {{ edit_name }}{% elseif is_submissions %}: {{ "PLUGIN_EASYFORMS.SUBMISSIONS"|t }} ({{ submissions_form }}){% endif %}</h1>
{% endblock %}

{% block content %}
<div id="admin-easyform">
    {% if not is_editor %}
        <div class="notices info">{{ "PLUGIN_EASYFORMS.INTRO_HELP"|t|markdown|raw }}</div>
        {% if easyforms_update and easyforms_update.available %}
        <div class="notices warning">
            {{ "PLUGIN_EASYFORMS.UPDATE_AVAILABLE"|t }}: v{{ easyforms_update.latest }}
            {% if easyforms_update.url %}
                (<a href="{{ easyforms_update.url }}" target="_blank" rel="noopener noreferrer">{{ "PLUGIN_EASYFORMS.RELEASE_NOTES"|t }}</a>)
            {% endif %}
            <form style="display:inline" method="post" action="{{ uri.addNonce(admin_route('/easyform') ~ '/task' ~ config.system.param_sep ~ 'easyformUpdate', 'admin-form', 'admin-nonce') }}">
                <button class="button small" type="submit" onclick="return confirm('{{ "PLUGIN_EASYFORMS.CONFIRM_UPDATE"|t }}')">
                    <i class="fa fa-refresh"></i> {{ "PLUGIN_EASYFORMS.APPLY_UPDATE"|t }}
                </button>
            </form>
        </div>
        {% elseif easyforms_update and easyforms_update.error and easyforms_update.error != 'No GitHub repository configured (plugins.easyform.github_repo).' %}
        <div class="notices error">{{ "PLUGIN_EASYFORMS.UPDATE_CHECK_FAILED"|t }}: {{ easyforms_update.error }}</div>
        {% endif %}
        {% if easyforms_list %}
        <table class="table-responsive">
            <thead>
                <tr>
                    <th>{{ "PLUGIN_EASYFORMS.COL_TITLE"|t }}</th>
                    <th>{{ "PLUGIN_EASYFORMS.COL_NAME"|t }}</th>
                    <th>{{ "PLUGIN_EASYFORMS.COL_SHORTCODE"|t }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for f in easyforms_list %}
                <tr>
                    <td>{{ f.title }}</td>
                    <td><code>{{ f.name }}</code></td>
                    <td>
                        <input type="text" class="easyform-shortcode" value="{{ f.shortcode }}" readonly onclick="this.select()" style="width: 240px;">
                        <button type="button" class="button small easyform-copy" data-copy="{{ f.shortcode }}"><i class="fa fa-clipboard"></i> {{ "PLUGIN_EASYFORMS.COPY"|t }}</button>
                    </td>
                    <td class="text-right">
                        <a class="button" href="{{ admin_route('/easyform/submissions/' ~ f.name) }}"><i class="fa fa-inbox"></i> {{ "PLUGIN_EASYFORMS.SUBMISSIONS"|t }}</a>
                        <a class="button" href="{{ admin_route('/easyform/edit/' ~ f.name) }}"><i class="fa fa-edit"></i> {{ "PLUGIN_EASYFORMS.EDIT"|t }}</a>
                        <a class="button" href="{{ uri.addNonce(admin_route('/easyform/edit/' ~ f.name) ~ '/task' ~ config.system.param_sep ~ 'easyformDelete', 'admin-form', 'admin-nonce') }}"
                           onclick="return confirm('{{ "PLUGIN_EASYFORMS.CONFIRM_DELETE"|t }}')">
                            <i class="fa fa-trash"></i> {{ "PLUGIN_EASYFORMS.DELETE"|t }}
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div class="notices info">{{ "PLUGIN_EASYFORMS.NO_FORMS"|t }}</div>
        {% endif %}
    {% elseif is_submission_detail %}
        {% if easyforms_submission %}
        <table class="table-responsive">
            <tbody>
                <tr><th>{{ "PLUGIN_EASYFORMS.COL_DATE"|t }}</th><td>{{ easyforms_submission.timestamp }}</td></tr>
                <tr><th>{{ "PLUGIN_EASYFORMS.COL_STATUS"|t }}</th><td>{{ easyforms_submission.status }}</td></tr>
                <tr><th>IP</th><td>{{ easyforms_submission.ip }}</td></tr>
                {% for key, value in easyforms_submission.values %}
                <tr><th>{{ key }}</th><td>{{ value }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
        <div class="button-bar" style="margin-top: 1em;">
            <a class="button" href="{{ uri.addNonce(admin_route('/easyform/submissions/' ~ submissions_form ~ '/' ~ submission_id) ~ '/task' ~ config.system.param_sep ~ 'easyformSubmissionDelete', 'admin-form', 'admin-nonce') }}"
               onclick="return confirm('{{ "PLUGIN_EASYFORMS.CONFIRM_DELETE_SUBMISSION"|t }}')">
                <i class="fa fa-trash"></i> {{ "PLUGIN_EASYFORMS.DELETE"|t }}
            </a>
        </div>
        {% else %}
        <div class="notices info">{{ "PLUGIN_EASYFORMS.NO_SUBMISSION"|t }}</div>
        {% endif %}
    {% elseif is_submissions %}
        {% if easyforms_submissions %}
        <table class="table-responsive">
            <thead>
                <tr>
                    <th>{{ "PLUGIN_EASYFORMS.COL_DATE"|t }}</th>
                    <th>{{ "PLUGIN_EASYFORMS.COL_STATUS"|t }}</th>
                    <th>{{ "PLUGIN_EASYFORMS.COL_SUMMARY"|t }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for s in easyforms_submissions %}
                <tr{% if s.status == 'unread' %} style="font-weight: bold;"{% endif %}>
                    <td><a href="{{ admin_route('/easyform/submissions/' ~ submissions_form ~ '/' ~ s.id) }}">{{ s.timestamp }}</a></td>
                    <td>{{ s.status }}</td>
                    <td>{{ s.values|join(', ') }}</td>
                    <td class="text-right">
                        {% set next_status = s.status == 'unread' ? 'read' : 'unread' %}
                        <a class="button small" href="{{ uri.addNonce(admin_route('/easyform/submissions/' ~ submissions_form ~ '/' ~ s.id) ~ '/task' ~ config.system.param_sep ~ 'easyformSubmissionStatus' ~ '/status' ~ config.system.param_sep ~ next_status, 'admin-form', 'admin-nonce') }}">
                            {{ s.status == 'unread' ? "PLUGIN_EASYFORMS.MARK_READ"|t : "PLUGIN_EASYFORMS.MARK_UNREAD"|t }}
                        </a>
                        <a class="button small" href="{{ uri.addNonce(admin_route('/easyform/submissions/' ~ submissions_form ~ '/' ~ s.id) ~ '/task' ~ config.system.param_sep ~ 'easyformSubmissionDelete', 'admin-form', 'admin-nonce') }}"
                           onclick="return confirm('{{ "PLUGIN_EASYFORMS.CONFIRM_DELETE_SUBMISSION"|t }}')">
                            <i class="fa fa-trash"></i>
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div class="notices info">{{ "PLUGIN_EASYFORMS.NO_SUBMISSIONS"|t }}</div>
        {% endif %}
    {% else %}
        {% set blueprints = data.blueprints %}
        {% include 'partials/blueprints.html.twig' with { data: data, blueprints: blueprints, form_id: 'easyform-editor' } %}
    {% endif %}
</div>

<script>
(function () {
    document.querySelectorAll('.easyform-copy').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var text = btn.getAttribute('data-copy');
            if (navigator.clipboard) {
                navigator.clipboard.writeText(text);
            }
        });
    });
})();
</script>
{% endblock %}
